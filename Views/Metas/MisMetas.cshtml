@model List<RunGymFront.Models.Metas>
@{
    ViewBag.Title = "Mis Metas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RunGym - Mis Metas</title>

    <!-- Tailwind CSS (Ya debería estar cargado por tu _Layout) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Poppins (Ya debería estar cargado por tu _Layout) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* Paleta de colores y variables consistentes con el Layout */
        :root {
            --primary-color: #ff5722;
            --secondary-color: #ff9800;
            --dark-background: #1f2833;
            --medium-background: #303d4b;
            --text-light: #FFFFFF;
            --text-muted: rgba(255, 255, 255, 0.7);
            --sidebar-border: rgba(255, 255, 255, 0.1);
            --success-color: #28a745;
            --danger-color: #dc3545;
            --transition-speed: 0.3s;
        }

        /* Aseguramos que el body de este contenido específico no interfiera con el layout principal */
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--dark-background);
            color: var(--text-muted);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* --- Animaciones --- */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes progress-animation {
            from { width: 0; }
        }

        /* --- Estilos Personalizados --- */
        .goal-card {
            background-color: var(--medium-background);
            border: 1px solid var(--sidebar-border);
            transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
        }

        .goal-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        }

        .goal-status {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-active { background-color: var(--secondary-color); color: white; }
        .status-completed { background-color: var(--success-color); color: white; }
        .status-expired { background-color: var(--danger-color); color: white; }

        .progress-bar-container {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .progress-bar {
            background: linear-gradient(90deg, var(--secondary-color), var(--primary-color));
            animation: progress-animation 1.5s ease-out forwards;
            transition: width 0.5s ease-out;
        }

        .floating-action-button {
            background: linear-gradient(45deg, var(--secondary-color), var(--primary-color));
            transition: all var(--transition-speed) ease;
            box-shadow: 0 4px 20px rgba(255, 87, 34, 0.5);
        }

        .floating-action-button:hover {
            transform: scale(1.1) rotate(15deg);
            box-shadow: 0 6px 25px rgba(255, 87, 34, 0.6);
        }

        .empty-state-card {
             background-color: var(--medium-background);
             border: 2px dashed var(--sidebar-border);
        }

    </style>
</head>
<body class="p-6 md:p-8">

    <!-- Contenido de la Vista "Mis Metas" -->
    <div class="space-y-10">

        <!-- 1. Encabezado de la Página -->
        <header style="animation: fadeInUp 0.5s ease-out;">
            <h1 class="text-4xl font-bold text-white flex items-center gap-3">
                <img src="https://api.iconify.design/marketeq:gold-medal.svg" alt="Icono Metas" class="w-9 h-9" style="filter: invert(70%) sepia(70%) saturate(1500%) hue-rotate(330deg) brightness(110%) contrast(100%);">
                Mis Metas
            </h1>
            <p class="text-lg text-text-muted mt-1">Visualiza, sigue y conquista tus objetivos.</p>
        </header>

        <!-- Contenedor de Alertas -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-500/20 border border-green-500 text-green-300 px-4 py-3 rounded-lg relative" role="alert" style="animation: fadeInUp 0.6s ease-out;">
                <span class="block sm:inline">@TempData["SuccessMessage"]</span>
            </div>
        }


        <!-- Contenedor de Metas -->
        <main class="space-y-6">

            @if (Model == null || Model.Count == 0)
            {
                <!-- CASO 1: No hay metas (Estado Vacío) -->
                <div class="empty-state-card text-center p-10 rounded-xl" style="animation: fadeInUp 0.6s ease-out;">
                    <img src="https://api.iconify.design/mdi:bullseye-arrow.svg" alt="Sin Metas" class="w-20 h-20 mx-auto text-sidebar-border">
                    <h2 class="text-2xl font-bold text-white mt-4">Aún no tienes metas</h2>
                    <p class="text-text-muted mt-2 max-w-sm mx-auto">¡Es el momento perfecto para establecer tu primer objetivo y comenzar tu transformación!</p>
                </div>
            }
            else
            {
                <!-- CASO 2: Hay metas, se muestran en un bucle -->
                foreach (var meta in Model)
                {
                    // --- LÓGICA DE PROGRESO Y ESTADO ---

                    // 1. Lógica de Tiempo y Estado (basada en el modelo proporcionado)
                    var fechaInicio = meta.FechaCreacion; // Usando FechaCreacion del modelo
                    var fechaObjetivo = meta.FechaObjetivo;
                    var diasRestantes = (fechaObjetivo - DateTime.Now).TotalDays;
                    var estadoMeta = "active";
                    if (diasRestantes <= 0)
                    {
                        estadoMeta = "completed";
                    }

                    // 2. Lógica de Progreso para la Barra (basada en tiempo transcurrido)
                    var diasTotales = (fechaObjetivo - fechaInicio).TotalDays;
                    if (diasTotales <= 0)
                    {
                        diasTotales = 1; // Evitar división por cero y manejar metas de un día
                    }
                    var diasTranscurridos = (DateTime.Now - fechaInicio).TotalDays;

                    // Calculamos el porcentaje, asegurándonos de que esté entre 0 y 100
                    var porcentajeProgreso = Math.Round(Math.Min(100.0, Math.Max(0.0, (diasTranscurridos / diasTotales) * 100.0)));

                    // Si la meta está completada, el progreso es 100%
                    if (estadoMeta == "completed")
                    {
                        porcentajeProgreso = 100;
                    }


                    <div class="goal-card rounded-xl p-6" style="animation: fadeInUp 0.7s ease-out;">
                        <!-- Encabezado de la tarjeta -->
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                            <h3 class="text-2xl font-bold text-white">@meta.MetaPrincipal</h3>
                            <span class="goal-status status-@estadoMeta">
                                @if (estadoMeta == "active")
                                {<text>En Progreso</text>}
                                @if (estadoMeta == "completed")
                                {<text>Completada</text>}
                                @if (estadoMeta == "expired")
                                {<text>Vencida</text>}
                            </span>
                        </div>

                        <!-- Detalles de la meta -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5 text-center">
                            <div>
                                <p class="text-sm text-text-muted">Cuerpo Actual</p>
                                <p class="font-semibold text-white">@meta.CuerpoActual</p>
                            </div>
                            <div>
                                <p class="text-sm text-text-muted">Cuerpo Deseado</p>
                                <p class="font-semibold text-white">@meta.CuerpoDeseado</p>
                            </div>
                            <div>
                                <p class="text-sm text-text-muted">Fecha Inicio</p>
                                <p class="font-semibold text-white">@meta.FechaCreacion.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div>
                                <p class="text-sm text-text-muted">Fecha Objetivo</p>
                                <p class="font-semibold text-white">@meta.FechaObjetivo.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <!-- Barra de Progreso -->
                        <div>
                            <div class="flex justify-between text-sm font-semibold text-text-muted mb-1">
                                <span>Progreso (@(porcentajeProgreso)%)</span>
                                @if (diasRestantes > 0)
                                {
                                    <span>Quedan @Math.Ceiling(diasRestantes) días</span>
                                }
                            </div>
                            <div class="progress-bar-container rounded-full h-3 overflow-hidden">
                                <div class="progress-bar h-full rounded-full"
                                     style="width: @(porcentajeProgreso)%; background: @(estadoMeta == "completed" ? "var(--success-color)" : "")"></div>
                            </div>
                        </div>

                        <!-- Acciones de la Tarjeta -->
                        <div class="border-t border-sidebar-border mt-4 pt-4 flex justify-end gap-2">
                            <a href="@Url.Action("Edit", "Metas", new { id = meta.Id })" title="Editar Meta" class="p-2 rounded-full hover:bg-dark-background transition-colors">
                                <img src="https://api.iconify.design/mdi:pencil.svg" alt="Editar" class="w-6 h-6 text-secondary-color">
                            </a>
                            <a href="@Url.Action("Delete", "Metas", new { id = meta.Id })" onclick="return confirm('¿Estás seguro de que quieres eliminar esta meta?');" title="Eliminar Meta" class="p-2 rounded-full hover:bg-dark-background transition-colors">
                                <img src="https://api.iconify.design/mdi:trash-can.svg" alt="Eliminar" class="w-6 h-6 text-danger-color">
                            </a>
                        </div>
                    </div>
                }
            }

        </main>
    </div>

    <!-- Botón Flotante para Agregar Nueva Meta -->
    <a href="@Url.Action("Metas", "Metas")" title="Agregar Nueva Meta" class="floating-action-button fixed bottom-8 right-8 w-16 h-16 rounded-full flex items-center justify-center text-white z-40">
        <img src="https://api.iconify.design/mdi:plus.svg" alt="Agregar" class="w-9 h-9">
    </a>

</body>
</html>

