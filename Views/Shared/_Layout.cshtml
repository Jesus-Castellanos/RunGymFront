<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RunGym - Panel</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("Scripts", required: false)
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/popperjs/core@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <style>
        /* Paleta de Colores DARK FITNESS (Carbón y Naranja Vibrante) */
        :root {
            --primary-color: #ff5722;       /* Rojo/Naranja Enérgico (Acento principal, vibrante) */
            --secondary-color: #ff9800;     /* Naranja Brillante (Inicio de degradado y acento secundario) */
            --dark-background: #1f2833;     /* Carbón Oscuro (Fondo principal) */
            --medium-background: #303d4b;   /* Azul Profundo/Carbón Medio (Fondo sidebar y contenido) */
            --text-light: #FFFFFF;          /* Blanco Puro (Texto principal) */
            --text-muted: rgba(255, 255, 255, 0.7); /* Texto Muteado (Links inactivos, etc) */
            --sidebar-border: rgba(255, 255, 255, 0.1); /* Borde sutil */
            --active-glow: rgba(255, 87, 34, 0.5); /* Sombra de acento */
            --transition: all 0.3s ease-out; /* Transición limpia */
        }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            /* Degradado de fondo tomado de tu CSS */
            background: linear-gradient(135deg, var(--dark-background) 0%, #303d4b 100%);
            min-height: 100vh;
            color: var(--text-light);
            display: flex;
            overflow-x: hidden;
            position: relative;
        }

        /* Sidebar con fondo carbón medio */
        .sidebar {
            width: 250px;
            height: 100vh;
            padding: 25px 20px;
            background-color: var(--medium-background);
            box-sizing: border-box;
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            backdrop-filter: blur(6px);
            border-right: 1px solid var(--sidebar-border);
            box-shadow: 5px 0 30px rgba(0, 0, 0, 0.4);
            transition: var(--transition);
            overflow: hidden;
        }

        .sidebar-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 30px;
            text-align: center;
            position: relative;
            padding-bottom: 20px;
        }

        .sidebar-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 10%;
            width: 80%;
            height: 2px;
            /* primary-color (Rojo Enérgico) */
            background: linear-gradient(90deg, transparent, var(--primary-color), transparent);
            border-radius: 100%;
        }

        .sidebar-header img {
            max-width: 90px;
            height: auto;
            border-radius: 50%;
            padding: 0.5rem;
            /* secondary-color (Naranja Brillante) */
            border: 3px solid var(--secondary-color);
            /* active-glow (Sombra de acento) */
            box-shadow: 0 0 20px var(--active-glow);
            transition: var(--transition);
            filter: drop-shadow(0 0 10px var(--active-glow));
            background-color: var(--text-light); /* Fondo blanco para el logo */
        }

        /* EFECTO HOVER EN LOGO: Agrandar e Iluminar */
        .sidebar-header img:hover {
            transform: scale(1.15);
            /* secondary-color (Naranja Brillante) */
            box-shadow: 0 0 40px var(--secondary-color);
        }

        /* TÍTULO con color de texto principal */
        .sidebar-header h4 {
            color: var(--text-light); /* Blanco Puro */
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.6rem;
            margin-top: 15px;
            letter-spacing: 3px;
            /* primary-color (Rojo Enérgico) */
            text-shadow: 0 0 5px var(--primary-color);
            transition: none;
            will-change: content, transform, text-shadow;
        }

        .sidebar hr {
            border: none;
            height: 1px;
            /* secondary-color (Naranja Brillante) */
            background: linear-gradient(90deg, transparent, var(--secondary-color), transparent);
            margin: 20px 0;
            width: 90%;
            align-self: center;
            opacity: 0.7;
        }

        .sidebar-nav {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            padding: 10px 0;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            color: var(--text-muted); /* Texto Muteado */
            text-decoration: none;
            padding: 18px 25px;
            margin-bottom: 10px;
            border-radius: 10px;
            position: relative;

            font-size: 0.9rem;
            font-family: 'Poppins', sans-serif;
            transform: scale(1.0);
            transition: var(--transition);
            background-color: rgba(0, 0, 0, 0.1); /* Fondo muy sutil */
            border-left: 5px solid transparent;
        }

        .sidebar-nav a span {
            display: inline-block;
            transition: var(--transition);
            letter-spacing: 1px;
            font-weight: 600;
        }

        /* Enlaces no activos: al pasar el ratón se ponen en primary-color (Rojo Enérgico) */
        .sidebar-nav a:not(.active):hover {
            /* secondary-color (Naranja Brillante) */
            background-color: rgba(255, 152, 0, 0.2);
            border-left: 5px solid var(--secondary-color);
            color: var(--text-light); /* Color del texto a Blanco */
            box-shadow: 0 0 25px rgba(255, 152, 0, 0.3);
            z-index: 10;
        }

        .sidebar-nav a:not(.active):hover span {
            font-weight: 700;
            text-shadow: 0 0 5px var(--secondary-color);
        }

        /* Enlaces activos: se ponen en primary-color (Rojo Enérgico) */
        .sidebar-nav a.active {
            transform: scale(1.0);
            /* Degradado de Naranja a Rojo */
            background: linear-gradient(90deg, rgba(255, 152, 0, 0.3) 0%, rgba(255, 87, 34, 0.3) 100%);
            border-left: 5px solid var(--primary-color);
            color: var(--text-light);
            box-shadow: 0 0 15px var(--active-glow);
        }

        .sidebar-nav a.active span {
            font-weight: 700;
            text-shadow: 0 0 5px var(--primary-color);
        }

        /* Filtro de iconos (invertir a blanco) */
        .sidebar-nav img {
            width: 26px;
            height: 26px;
            margin-right: 20px;
            /* Filtro: invertir a blanco y dar un tono sutil de azul/naranja */
            filter: invert(100%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(100%) contrast(100%);
            opacity: 0.7;
            transform: scale(1.0);
            transition: var(--transition);
        }

        .sidebar-nav a:not(.active):hover img {
            transform: scale(1.0);
            /* Filtro secondary-color en hover (Naranja Brillante) */
            filter: invert(70%) sepia(70%) saturate(1500%) hue-rotate(330deg) brightness(110%) contrast(100%);
            opacity: 1;
        }

        .sidebar-nav a.active img {
             transform: scale(1.0);
             /* Filtro primary-color en activo (Rojo Enérgico) */
             filter: invert(50%) sepia(90%) saturate(4000%) hue-rotate(340deg) brightness(100%) contrast(100%);
             opacity: 1;
        }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid var(--sidebar-border);
        }

        .sidebar-footer a {
            display: flex;
            align-items: center;
            color: var(--text-muted);
            text-decoration: none;
            padding: 18px 25px;
            border-radius: 10px;
            transition: var(--transition);
            position: relative;
            transform: scale(1.0);
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
        }

        .sidebar-footer a:hover {
            transform: scale(1.0);
            /* secondary-color (Naranja Brillante) */
            background-color: rgba(255, 152, 0, 0.15);
            color: var(--secondary-color);
            box-shadow: 0 0 20px rgba(255, 152, 0, 0.5);
        }

        .sidebar-footer a span {
            font-weight: 600;
        }

        .sidebar-footer img {
            width: 24px;
            height: 24px;
            margin-right: 20px;
            /* Filtro secondary-color para iconos del footer */
            filter: invert(100%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(100%) contrast(100%);
            opacity: 0.7;
            transform: scale(1.0);
            transition: var(--transition);
        }

        /* Contenido principal con fondo carbón medio (slightly lighter) */
        .content {
            margin-left: 250px;
            flex-grow: 1;
            padding: 30px;
            background-color: var(--medium-background);
            min-height: 100vh;
            backdrop-filter: blur(8px);
            transition: var(--transition);
            box-shadow: inset 10px 0 20px rgba(0, 0, 0, 0.3); /* Sombra interna para profundidad */
        }

        /* [Estilos Responsive y Modal] */
        @@media (max-width: 992px) {
            .sidebar {
                width: 220px;
                padding: 20px 15px;
            }

            .content {
                margin-left: 220px;
                padding: 20px;
            }
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 80px;
                padding: 20px 10px;
                align-items: center;
            }

            .sidebar-header h4,
            .sidebar-nav span,
            .sidebar-footer span {
                display: none;
            }

            .sidebar-nav a,
            .sidebar-footer a {
                justify-content: center;
                padding: 18px 10px;
                margin-bottom: 10px;
            }

            .sidebar-nav img,
            .sidebar-footer img {
                margin-right: 0;
                width: 28px;
                height: 28px;
            }

            .content {
                margin-left: 80px;
            }

            .sidebar-header img {
                max-width: 60px;
            }
        }

        @@media (max-width: 576px) {
            .sidebar {
                transform: translateX(-100%);
                z-index: 1001;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0;
            }

            .menu-toggle {
                display: block;
                position: fixed;
                top: 20px;
                left: 20px;
                z-index: 1000;
            }
        }

        /* Estilos del Modal adaptados al tema oscuro y enérgico */
        .modal-content {
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
            border: none;
            width: 100%;
            max-width: 450px;
            background-color: var(--medium-background); /* Fondo del modal: Carbón Medio */
            color: var(--text-light);
        }

        .modal-header {
            /* Degradado con secondary-color y primary-color (Naranja a Rojo) */
            background: linear-gradient(45deg, var(--secondary-color), var(--primary-color));
            color: var(--text-light); /* Blanco Puro */
            padding: 25px;
            border-bottom: none;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .modal-header .warning-icon {
            font-size: 2rem;
            animation: pulse-vibrant 1.5s infinite;
            color: var(--text-light); /* Blanco Puro */
        }

        .modal-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            color: var(--text-light);
            text-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
        }

        .modal-body {
            padding: 30px;
            background-color: var(--dark-background); /* Fondo del body del modal: Carbón Oscuro */
            text-align: center;
            color: var(--text-muted);
        }

        .message {
            font-size: 1.1rem;
            color: var(--text-light);
            margin-bottom: 15px;
        }

        .question {
            font-weight: 700;
            /* primary-color (Rojo Enérgico) */
            color: var(--primary-color);
            margin-top: 15px;
        }

        #countdown {
            font-weight: bold;
            /* primary-color (Rojo Enérgico) */
            color: var(--primary-color);
            text-shadow: 0 0 5px var(--active-glow);
        }

        .progress {
            height: 10px;
            margin: 20px 0 10px;
            /* primary-color (Rojo Enérgico) */
            background-color: rgba(255, 87, 34, 0.2);
            border-radius: 5px;
            overflow: hidden;
        }

        .progress-bar {
            width: 100%;
            height: 100%;
            /* Degradado con secondary-color y primary-color */
            background: linear-gradient(to right, var(--secondary-color), var(--primary-color));
            transition: width 1s linear;
        }

        .modal-footer {
            background-color: var(--dark-background); /* Footer del modal: Carbón Oscuro */
            /* sidebar-border (Borde sutil) */
            border-top: 1px solid var(--sidebar-border);
            padding: 20px 25px;
            text-align: center;
        }

        .btn-primary {
            /* Degradado con secondary-color y primary-color */
            background: linear-gradient(to right, var(--secondary-color), var(--primary-color));
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 700;
            transition: all 0.3s;
            color: var(--text-light); /* Blanco Puro */
            /* active-glow */
            box-shadow: 0 4px 20px var(--active-glow);
        }

        .btn-primary:hover {
            transform: scale(1.05);
            /* primary-color */
            box-shadow: 0 8px 30px var(--primary-color);
            filter: brightness(1.1);
        }

        /* Animación de pulso con primary-color (Rojo Enérgico) */
        @@keyframes pulse-vibrant {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 87, 34, 0.7); }
            70% { transform: scale(1.1); box-shadow: 0 0 0 15px rgba(255, 87, 34, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 87, 34, 0); }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <div>
                <img src="~/Imagenes/Logo.png" alt="RunGym Logo">
            </div>
            <div>
                <h4>RunGym</h4>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Home")" class="nav-item" id="inicio-link">
                <img src="https://api.iconify.design/mdi:home.svg" alt="Inicio">
                <span>Inicio</span>
            </a>
            <a href="@Url.Action("Ejercicios", "Ejercicios")" class="nav-item" id="rutinas-link">
                <img src="https://api.iconify.design/arcticons:home-workouts.svg" alt="Rutinas">
                <span>Rutinas</span>
            </a>
            <a href="@Url.Action("Dieta", "Dieta")" class="nav-item" id="dieta-link">
                <img src="https://api.iconify.design/arcticons:mynetdiary.svg" alt="Dieta">
                <span>Dieta</span>
            </a>
            <a href="@Url.Action("MisMetas", "Metas")" class="nav-item" id="mismetas-link">
                <img src="https://api.iconify.design/marketeq:gold-medal.svg" alt="Metas">
                <span>Mis Metas</span>
            </a>
            <a href="@Url.Action("Perfil", "Perfil")" class="nav-item" id="perfil-link">
                <img src="https://api.iconify.design/iconoir:profile-circle.svg" alt="Perfil">
                <span>Perfil</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a href="@Url.Action("Contact", "Home")" class="nav-item" id="Ayuda-link">
                <img src="https://api.iconify.design/material-symbols:help-rounded.svg" alt="Ayuda">
                <span>Ayuda</span>
            </a>
            <a href="#" class="nav-item" id="logout-link">
                <img src="https://api.iconify.design/material-symbols:logout-rounded.svg" alt="Cerrar sesión">
                <span>Cerrar sesión</span>
            </a>
        </div>
    </aside>

    <div class="content" id="content">
        @RenderBody()
    </div>

    <div class="modal fade" id="inactivityModal" tabindex="-1" role="dialog" aria-labelledby="inactivityModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <span class="warning-icon">⏳</span>
                    <h5 class="modal-title" id="inactivityModalLabel">Sesión a punto de expirar</h5>
                </div>

                <div class="modal-body">
                    <p class="message">
                        Por seguridad, tu sesión se cerrará en <span id="countdown">30</span> segundos por inactividad.
                    </p>
                    <div class="progress">
                        <div class="progress-bar" id="progressBar"></div>
                    </div>
                    <p class="question">¿Deseas continuar conectado?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" id="stayLoggedInBtn" class="btn btn-primary" data-bs-dismiss="modal">Continuar sesión</button>
                </div>
            </div>
        </div>
    </div>


    <form id="logoutForm" method="post" action="@Url.Action("LogOff", "Login")" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const content = document.querySelector('#content');

            // Definición de la animación fadeIn
            const style = document.createElement('style');
            style.innerHTML = `
                @@keyframes fadeIn {
                    from { opacity: 0; transform: translateY(20px); }
                    to { opacity: 1; transform: translateY(0); }
                }
            `;
            document.head.appendChild(style);

            content.style.animation = 'fadeIn 0.8s ease-out';

            // Lógica para marcar el enlace activo.
            function setActiveLink() {
                const currentPath = window.location.pathname.toLowerCase();
                const navLinks = document.querySelectorAll('.sidebar-nav a');

                navLinks.forEach(link => {
                    link.classList.remove('active');

                    let linkHref = link.getAttribute('href').toLowerCase();

                    // Ajusta la comparación para que coincida con la URL de la página
                    if (currentPath.includes(linkHref) && linkHref !== '/') {
                        link.classList.add('active');
                    } else if (linkHref === '@Url.Action("Index", "Home")'.toLowerCase() && (currentPath === '/' || currentPath === '@Url.Action("Index", "Home")'.toLowerCase())) {
                        // Caso especial para la página de inicio
                         link.classList.add('active');
                    }
                });
            }

            // Ejecuta la función al cargar la página
            setActiveLink();
        });

        // Lógica de inactividad
        (function() {
        const inactivityLimit = @((Convert.ToInt32(ViewBag.InactivityLimitMilliseconds ?? 15 * 60 * 1000)));
        const countdownTime = 15;

        let inactivityTimer;
        let countdownTimer;
        let countdown = countdownTime;

        const modal = new bootstrap.Modal(document.getElementById('inactivityModal'), {
            backdrop: 'static',
            keyboard: false
        });

        const countdownElement = document.getElementById('countdown');
        const stayLoggedInBtn = document.getElementById('stayLoggedInBtn');

        function resetInactivityTimer() {
            clearTimeout(inactivityTimer);
            clearInterval(countdownTimer);
            countdown = countdownTime;
            countdownElement.textContent = countdown;
            modal.hide();
            inactivityTimer = setTimeout(showWarningModal, inactivityLimit);
        }

        function showWarningModal() {
            modal.show();
            countdownTimer = setInterval(() => {
                countdown--;
                countdownElement.textContent = countdown;

                if (countdown <= 0) {
                    clearInterval(countdownTimer);
                    logoutUser();
                }
            }, 1000);
        }

        function logoutUser() {
             document.getElementById('logoutForm').submit();
        }

        stayLoggedInBtn.addEventListener('click', () => {
            resetInactivityTimer();
        });

        ['mousemove', 'keydown', 'scroll', 'touchstart'].forEach(event => {
            document.addEventListener(event, resetInactivityTimer, false);
        });

        resetInactivityTimer();
        })();

        // Funciones para el cierre de sesión y manejo de caché
        document.addEventListener("DOMContentLoaded", function () {
            const logoutLink = document.getElementById("logout-link");
            const logoutForm = document.getElementById("logoutForm");

            if (logoutLink && logoutForm) {
                logoutLink.addEventListener("click", function (e) {
                    e.preventDefault();
                    logoutForm.submit();
                });
            }
        });

        window.onload = function () {
            const logoutLink = document.getElementById("logout-link");
            const logoutForm = document.getElementById("logoutForm");

            if (logoutLink && logoutForm) {
                logoutLink.addEventListener("click", function (e) {
                    e.preventDefault();
                    logoutForm.submit();
                });
            }
        };

        window.addEventListener("pageshow", function (event) {
            const navType = window.performance?.getEntriesByType("navigation")[0]?.type;

            if (event.persisted || navType === "back_forward") {
                document.body.style.display = "none";
                sessionStorage.clear();
                localStorage.clear();

                document.cookie.split(";").forEach(function (c) {
                    document.cookie = c
                        .replace(/^ +/, "")
                        .replace(/=.*/, "=;expires=" + new Date().toUTCString() + ";path=/");
                });

                window.location.replace("/Login/Login");
            }
        });
    </script>
</body>
</html>
