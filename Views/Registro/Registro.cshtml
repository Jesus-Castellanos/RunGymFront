@model RunGymFront.Models.Usuarios
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - RunGym | Elegante</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* ======================================= */
        /* PALETA CÁLIDA Y ACOGEDORA */
        /* ======================================= */
        :root {
            /* Colores de alto impacto y energía */
            --primary-color: #ffcc80; /* Dorado Suave / Apricot */
            --secondary-color: #f4a261; /* Naranja Quemado / Burnt Orange */
            --background-dark: #1e140d; /* Fondo muy oscuro, tono Sepia */
            --container-bg: rgba(30, 20, 10, 0.9); /* Fondo del contenedor semi-transparente cálido */
            --input-bg: rgba(45, 30, 15, 0.8); /* Fondo de input ligeramente más claro */
            --glow-primary: 0 0 15px rgba(255, 204, 128, 0.7);
            --glow-secondary: 0 0 10px rgba(244, 162, 97, 0.6);
            --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        /* ======================================= */
        /* ESTILOS GENERALES Y FONDO DRAMÁTICO */
        /* ======================================= */
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            background-color: var(--background-dark); /* Color base */
            background-image: url('/images/Login/Fondo.jpg'); /* Mantiene tu ruta original */
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            color: #f5f5f5; /* Color de texto claro */
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
            position: relative;
            overflow-x: hidden;
        }

            /* Capa de oscuridad cálida y desenfoque */
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(30, 20, 10, 0.85); /* Tono cálido oscuro */
                backdrop-filter: blur(8px);
                z-index: -2; /* Detrás del canvas de partículas */
            }

        /* CANVA DE PARTÍCULAS */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1; /* Entre el body::before y el contenido principal */
            opacity: 0.7;
        }


        /* Animación para el título */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .container {
            max-width: 900px;
            width: 100%;
            background-color: var(--container-bg);
            border-radius: 20px;
            /* Box Shadow con glow suave */
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5), var(--glow-primary);
            backdrop-filter: blur(12px);
            padding: 3rem;
            margin: 2rem auto;
            border: 2px solid rgba(255, 204, 128, 0.4);
            animation: fadeIn 1s ease-out;
            position: relative;
            overflow: hidden;
            z-index: 10; /* Asegura que el contenido esté al frente */
        }


        h2 {
            font-weight: 700;
            text-align: center;
            margin-bottom: 3rem;
            /* Texto con glow de neón suave */
            text-shadow: 0 0 8px var(--primary-color), 0 0 3px var(--secondary-color);
            letter-spacing: 2px;
            color: var(--primary-color);
            position: relative;
            text-transform: uppercase;
        }

            /* Línea decorativa cálida bajo el título */
            h2::after {
                content: '';
                position: absolute;
                bottom: -15px;
                left: 30%;
                width: 40%;
                height: 3px;
                background: linear-gradient(90deg, transparent, var(--secondary-color), var(--primary-color), transparent);
                border-radius: 2px;
                box-shadow: 0 0 10px var(--secondary-color);
            }

        /* ======================================= */
        /* ESTILOS DE LOGO */
        /* ======================================= */
        .logo-container {
            margin-bottom: 3rem;
            text-align: center;
        }

        .logo {
            max-width: 150px;
            height: auto;
            border-radius: 50%;
            border: 4px solid var(--secondary-color);
            box-shadow: var(--glow-secondary);
            transition: var(--transition);
            filter: drop-shadow(0 0 10px var(--primary-color));
        }

            .logo:hover {
                transform: scale(1.05) rotate(-3deg);
                filter: drop-shadow(0 0 15px var(--secondary-color));
            }

        /* ======================================= */
        /* FORMULARIO E INPUTS */
        /* ======================================= */
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-bottom: 1rem;
        }

        .form-group {
            flex: 1 1 calc(50% - 0.75rem);
            min-width: 250px;
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-label {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: block;
            text-shadow: 0 0 5px rgba(255, 204, 128, 0.4);
        }

        .form-control, .form-select {
            min-height: 50px;
            width: 100%;
            padding: 10px 15px;
            border-radius: 8px;
            background-color: var(--input-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            transition: var(--transition);
            box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.6);
            font-size: 1rem;
        }

            .form-control:focus, .form-select:focus {
                background-color: rgba(60, 40, 20, 0.9);
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 0.25rem rgba(244, 162, 97, 0.3), inset 0 0 15px rgba(255, 204, 128, 0.1);
                color: #ffffff;
                outline: none;
            }

            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.6);
            }

            .form-select option {
                background-color: var(--background-dark);
                color: #fff;
            }

        /* Mensajes de validación */
        .text-danger {
            color: var(--secondary-color);
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: block;
            font-weight: 500;
            text-align: left;
        }

        /* Checkbox de términos y condiciones */
        .form-check-input {
            width: 18px;
            height: 18px;
            border: 2px solid var(--primary-color);
            background-color: var(--input-bg);
            transition: var(--transition);
            margin-top: 0;
            cursor: pointer;
        }

            .form-check-input:checked {
                background-color: var(--secondary-color);
                border-color: var(--secondary-color);
                box-shadow: 0 0 10px var(--secondary-color);
            }

        .form-check-label a {
            color: var(--primary-color);
            text-decoration: underline;
            transition: color 0.2s;
        }

            .form-check-label a:hover {
                color: var(--secondary-color);
            }

        /* Ocultar pasos inactivos */
        .form-step {
            display: none;
            animation: slideIn 0.5s ease-out;
        }

            .form-step.active {
                display: block;
            }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ======================================= */
        /* ESTILOS DE BOTONES DE NAVEGACIÓN */
        /* ======================================= */
        .btn-base {
            border: none;
            border-radius: 10px;
            padding: 12px 28px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--background-dark);
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            z-index: 1;
            margin-top: 1rem;
            text-transform: uppercase;
            overflow: hidden;
        }

            .btn-base::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 300%;
                height: 300%;
                background: rgba(255, 255, 255, 0.1);
                transition: all 0.5s;
                border-radius: 50%;
                transform: translate(-50%, -50%) scale(0);
                z-index: -1;
            }

            .btn-base:hover::before {
                transform: translate(-50%, -50%) scale(1);
            }

        /* Botón Primario y Siguiente (Dorado Sólido) */
        .btn-primary, .next-step-btn {
            background-color: var(--primary-color);
            box-shadow: 0 5px 15px rgba(255, 204, 128, 0.5);
            color: var(--background-dark);
        }

            .btn-primary:hover, .next-step-btn:hover {
                background-color: var(--secondary-color); /* Hover a Naranja Quemado */
                color: #fff;
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(244, 162, 97, 0.8);
            }

            .btn-primary:disabled {
                background-color: rgba(255, 204, 128, 0.4);
                box-shadow: none;
                transform: none;
                cursor: not-allowed;
                color: rgba(30, 20, 13, 0.6);
            }

        /* Botón Volver (Naranja Contorno) */
        .btn-back {
            background-color: transparent;
            border: 2px solid var(--secondary-color);
            color: var(--secondary-color);
            box-shadow: none;
        }

            .btn-back:hover {
                background-color: rgba(244, 162, 97, 0.15);
                color: var(--primary-color); /* Color de texto a Dorado en hover */
                border-color: var(--primary-color);
                box-shadow: 0 0 15px rgba(244, 162, 97, 0.5);
                transform: translateY(-3px);
            }

        /* ======================================= */
        /* BARRA DE PROGRESO */
        /* ======================================= */
        .progress-bar-container {
            height: 8px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            margin-bottom: 3rem;
            box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.5);
        }

        .progress-bar {
            height: 100%;
            /* Degradado cálido */
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            box-shadow: 0 0 8px var(--primary-color);
            border-radius: 4px;
            width: 0%;
            transition: width 0.4s ease-in-out;
        }

        /* ======================================= */
        /* ESTILOS RESPONSIVOS */
        /* ======================================= */
        @@media (max-width: 992px) {
            .container {
                padding: 2rem;
            }
        }

        @@media (max-width: 768px) {
            .container {
                padding: 1.5rem;
                margin: 1rem 0;
            }

            .logo {
                max-width: 120px;
            }

            h2 {
                font-size: 1.75rem;
                letter-spacing: 1px;
            }

            .form-group {
                flex: 1 1 100%; /* Una columna en móvil */
                min-width: 100%;
            }

            h2::after {
                left: 20%;
                width: 60%;
            }
        }
    </style>
</head>
<body>
    <!-- CANVAS PARA LA ANIMACIÓN DE PARTÍCULAS EN EL FONDO -->
    <canvas id="particleCanvas"></canvas>

    <div class="container text-center">
        <div class="logo-container">
            <img src="/images/Login/Logo.png" alt="RunGym Logo" class="logo img-fluid" aria-label="RunGym Logo">
        </div>

        <h2>Registro de Nuevo Usuario</h2>

        <!-- Barra de Progreso -->
        <div class="progress-bar-container">
            <div id="progressBar" class="progress-bar"></div>
        </div>

        @Html.AntiForgeryToken()
        @using (Html.BeginForm("Registro", "Registro", FormMethod.Post, new { id = "registroForm" }))
        {
            <!-- Campos ocultos de configuración -->
            <input type="hidden" name="RolId" value="2" />

            <!-- PASO 1: Información de la Cuenta -->
            <div id="step-1" class="form-step active">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej: Juan", required = "required" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Apellido, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", placeholder = "Ej: Pérez", required = "required" })
                        @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-12">
                        @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", placeholder = "ejemplo@correo.com", type = "email" })
                        @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Contraseña, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Contraseña, new
                        {
                            @class = "form-control",
                            placeholder = "Mínimo 4 números (PIN)",
                            @maxlength = "4",
                            @pattern = "[0-9]{4}",
                            title = "La contraseña debe contener solo 4 números",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.Contraseña, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.ConfirmarContraseña, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmarContraseña, new
                        {
                            @class = "form-control",
                            placeholder = "Repita su PIN",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.ConfirmarContraseña, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="mt-4 d-flex justify-content-end">
                    <button type="button" class="btn-base next-step-btn">Siguiente <i class="fas fa-arrow-right"></i></button>
                </div>
            </div>

            <!-- PASO 2: Datos Personales -->
            <div id="step-2" class="form-step">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.TipoDocumento, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.TipoDocumento, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Seleccione tipo de documento", Value = "" },
                            new SelectListItem { Text = "Cédula", Value = "Cedula" },
                            new SelectListItem { Text = "Pasaporte", Value = "Pasaporte" },
                            new SelectListItem { Text = "DNI", Value = "DNI" }
                        }, new { @class = "form-select", required = "required" })
                        @Html.ValidationMessageFor(m => m.TipoDocumento, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Documento, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Documento, new { @class = "form-control", placeholder = "Número de documento", required = "required" })
                        @Html.ValidationMessageFor(m => m.Documento, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Celular, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Celular, new { @class = "form-control", placeholder = "Ej: 3001234567", type = "tel" })
                        @Html.ValidationMessageFor(m => m.Celular, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.FechaNacimiento, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                        @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Genero, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Genero, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Seleccione su género", Value = "" },
                            new SelectListItem { Text = "Masculino", Value = "Masculino" },
                            new SelectListItem { Text = "Femenino", Value = "Femenino" },
                            new SelectListItem { Text = "Otro", Value = "Otro" }
                        }, new { @class = "form-select", required = "required" })
                        @Html.ValidationMessageFor(m => m.Genero, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="mt-4 d-flex justify-content-between">
                    <button type="button" class="btn-base btn-back prev-step-btn"><i class="fas fa-arrow-left"></i> Anterior</button>
                    <button type="button" class="btn-base next-step-btn">Siguiente <i class="fas fa-arrow-right"></i></button>
                </div>
            </div>

            <!-- PASO 3: Hábitos y Finalización -->
            <div id="step-3" class="form-step">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Peso, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Peso, new { @class = "form-control", placeholder = "Ej: 76 kg", type = "number", step = "any" })
                        @Html.ValidationMessageFor(m => m.Peso, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.Altura, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Altura, new
                        {
                            @class = "form-control",
                            placeholder = "Ej: 1.75 m",
                            type = "number",
                            step = "0.01",
                            lang = "en-US"
                        })
                        @Html.ValidationMessageFor(m => m.Altura, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.HorasSueno, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.HorasSueno, new { @class = "form-control", placeholder = "Ej: 7 horas", type = "number", step = "any" })
                        @Html.ValidationMessageFor(m => m.HorasSueno, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.ConsumoAgua, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ConsumoAgua, new { @class = "form-control", placeholder = "Ej: 2.5 litros", type = "text" })
                        @Html.ValidationMessageFor(m => m.ConsumoAgua, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Checkbox de Términos -->
                <div class="form-group form-check text-left d-flex align-items-center mt-4">
                    <input type="checkbox" class="form-check-input" id="terminos" required>
                    <label class="form-check-label ml-2" for="terminos" style="font-weight: 400; color: white;">Acepto los <a href="#" style="color: var(--primary-color); text-decoration: underline;">términos y condiciones</a></label>
                </div>

                <!-- Botones de Acción Final -->
                <div class="mt-4 d-flex justify-content-between">
                    <button type="button" class="btn-base btn-back prev-step-btn"><i class="fas fa-arrow-left"></i> Anterior</button>
                    <!-- El botón de submit está deshabilitado hasta aceptar los términos -->
                    <button type="submit" class="btn-primary btn-base" id="submitBtn" disabled>Registrarse <i class="fas fa-user-plus"></i></button>
                </div>
            </div>
        }
    </div>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            const formSteps = $('.form-step');
            const progressBar = $('#progressBar');
            const submitBtn = $('#submitBtn');
            const terminosCheckbox = $('#terminos');
            let currentStep = 0;

            // Mostrar el primer paso al cargar
            updateForm();

            // Función de validación de paso
            function validateStep(step) {
                let isValid = true;
                // Ejecutar la validación unobtrusive/jQuery Validate
                if (!$("#registroForm").valid()) {
                    isValid = false;
                }

                // Validación especial para Confirmar Contraseña (solo en el paso 1)
                if (currentStep === 0) {
                    // Aseguramos que los valores sean strings para evitar el error 'Cannot read properties of undefined (reading 'length')'
                    const pass = String($('#Contraseña').val() || '');
                    const confirmPass = String($('#ConfirmarContraseña').val() || '');

                    if (pass !== confirmPass && pass.length > 0) {
                        // Usar el span generado por ValidationMessageFor
                        $('#Contraseña-error').text('Las contraseñas no coinciden.').addClass('text-danger');
                        isValid = false;
                    } else if (pass.length > 0) {
                        $('#Contraseña-error').text('').removeClass('text-danger');
                    }
                }

                // Si el formulario general es inválido, forzar a que sea inválido para el paso actual.
                // Esto es crucial para que los mensajes de error se muestren correctamente.
                step.find('input[required], select[required], input[type="email"]').each(function () {
                    if (!$(this).valid()) {
                        isValid = false;
                    }
                });

                return isValid;
            }

            // Actualiza la vista (paso y progreso)
            function updateForm() {
                formSteps.hide();
                formSteps.eq(currentStep).fadeIn(400);

                // Actualiza la barra de progreso
                const progress = (currentStep / (formSteps.length - 1)) * 100;
                progressBar.css('width', `${progress}%`);

                // Habilita/Deshabilita el botón de Registrarse
                if (currentStep === formSteps.length - 1) {
                    checkFinalValidation();
                }
            }

            // Lógica para habilitar/deshabilitar el botón final
            function checkFinalValidation() {
                const termsAccepted = terminosCheckbox.is(':checked');
                // El botón solo se habilita si los términos son aceptados
                submitBtn.prop('disabled', !termsAccepted);
            }

            // Navegación Siguiente
            $(document).on('click', '.next-step-btn', function () {
                const currentStepForm = formSteps.eq(currentStep);
                if (validateStep(currentStepForm)) {
                    currentStep++;
                    updateForm();
                } else {
                    // Si la validación falla, forzar a mostrar los errores del paso actual
                    currentStepForm.find('input, select').each(function () {
                        $(this).valid();
                    });
                }
            });

            // Navegación Anterior
            $(document).on('click', '.prev-step-btn', function () {
                currentStep--;
                updateForm();
            });

            // Listener para el checkbox de términos
            terminosCheckbox.on('change', checkFinalValidation);
        });

        // ===============================================
        // LÓGICA DE ANIMACIÓN DE PARTÍCULAS (JavaScript Nativo)
        // ===============================================
        window.onload = function () {
            const canvas = document.getElementById('particleCanvas');
            const ctx = canvas.getContext('2d');
            let particles = [];
            const particleCount = 70;
            const particleColors = ['#ffcc80', '#f4a261', 'rgba(255, 255, 255, 0.5)']; // Dorado, Naranja, Crema

            // Función para obtener un color aleatorio de la paleta cálida
            function getRandomColor() {
                return particleColors[Math.floor(Math.random() * particleColors.length)];
            }

            // Clase Partícula
            class Particle {
                constructor(x, y) {
                    this.x = x || Math.random() * canvas.width;
                    this.y = y || Math.random() * canvas.height;
                    this.radius = Math.random() * 2 + 1; // Tamaño de 1 a 3
                    this.color = getRandomColor();
                    // Movimiento lento y hacia arriba
                    this.velocity = {
                        x: (Math.random() - 0.5) * 0.3,
                        y: (Math.random() * -0.2) - 0.1
                    };
                    this.opacity = Math.random() * 0.5 + 0.3; // Opacidad sutil
                }

                draw() {
                    ctx.save();
                    ctx.globalAlpha = this.opacity;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
                    ctx.fillStyle = this.color;
                    ctx.fill();
                    ctx.restore();
                }

                update() {
                    // Aplica movimiento
                    this.x += this.velocity.x;
                    this.y += this.velocity.y;

                    // Reinicia la partícula si sale por arriba
                    if (this.y < 0) {
                        this.y = canvas.height;
                        this.x = Math.random() * canvas.width;
                    }

                    // Reinicia la partícula si sale por los lados (opcional, para mantenerlas en pantalla)
                    if (this.x > canvas.width || this.x < 0) {
                        this.x = Math.random() * canvas.width;
                    }

                    this.draw();
                }
            }

            // Inicialización
            function init() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
                particles = [];
                for (let i = 0; i < particleCount; i++) {
                    particles.push(new Particle());
                }
            }

            // Bucle de animación
            function animate() {
                requestAnimationFrame(animate);
                // Oscurecer el canvas un poco en cada cuadro para crear un rastro suave (efecto "glow")
                ctx.fillStyle = 'rgba(30, 20, 13, 0.1)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                particles.forEach(particle => {
                    particle.update();
                });
            }

            // Manejar redimensionamiento
            window.addEventListener('resize', init);

            // Iniciar la animación
            init();
            animate();
        }
    </script>
</body>
</html>