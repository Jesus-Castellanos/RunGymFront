<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RunGym - Panel de Inicio</title>

    <!-- Tailwind CSS (Ya debería estar cargado por tu _Layout) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Poppins (Ya debería estar cargado por tu _Layout) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* Paleta de colores y variables consistentes con el Layout */
        :root {
            --primary-color: #ff5722;
            --secondary-color: #ff9800;
            --dark-background: #1f2833;
            --medium-background: #303d4b;
            --text-light: #FFFFFF;
            --text-muted: rgba(255, 255, 255, 0.7);
            --sidebar-border: rgba(255, 255, 255, 0.1);
            --active-glow: rgba(255, 87, 34, 0.5);
            --transition-speed: 0.3s;
        }

        /* Aseguramos que el body de este contenido específico no interfiera con el layout principal */
        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--dark-background); /* Coincide con el fondo del contenido del layout */
            color: var(--text-muted);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* --- Animaciones --- */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- Estilos Personalizados para los Widgets del Dashboard --- */
        .summary-card {
            background-color: var(--medium-background);
            border: 1px solid var(--sidebar-border);
            transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
        }

        .summary-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        }

        .summary-card .icon-bg {
             background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));
        }

        .progress-bar-container {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .progress-bar {
            background: linear-gradient(90deg, var(--secondary-color), var(--primary-color));
        }

        .chart-container {
            background-color: var(--medium-background);
            border: 1px solid var(--sidebar-border);
        }

        .btn-custom-secondary {
            background-color: var(--medium-background);
            border: 1px solid var(--secondary-color);
            color: var(--secondary-color);
            transition: all var(--transition-speed) ease;
        }

        .btn-custom-secondary:hover {
            background-color: var(--secondary-color);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 152, 0, 0.3);
        }

        /* Estilo para el SVG del gráfico */
        .chart-line {
            stroke: var(--primary-color);
            stroke-width: 3;
            fill: none;
            stroke-dasharray: 1000;
            stroke-dashoffset: 1000;
            animation: draw-chart 2s ease-out forwards;
        }

        .chart-dot {
            fill: var(--secondary-color);
            stroke: var(--dark-background);
            stroke-width: 2;
            opacity: 0;
            animation: fade-in-dots 0.5s ease-out forwards;
        }

        @@keyframes draw-chart {
            to {
                stroke-dashoffset: 0;
            }
        }

        @@keyframes fade-in-dots {
             to {
                opacity: 1;
            }
        }

    </style>
</head>
<body class="p-6 md:p-8">

    <!-- Contenido del Panel de Inicio -->
    <div class="space-y-10">

        <!-- 1. Encabezado de Bienvenida -->
        <header style="animation: fadeInUp 0.5s ease-out;">
            <h1 class="text-4xl font-bold text-white">¡Bienvenido de nuevo, Usuario!</h1>
            <p class="text-lg text-text-muted mt-1">Aquí tienes un resumen de tu actividad de hoy.</p>
        </header>

        <!-- 2. Tarjetas de Resumen (KPIs) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Card 1: Rutina de Hoy -->
            <div class="summary-card rounded-xl p-6 flex items-center space-x-4" style="animation: fadeInUp 0.6s ease-out;">
                <div class="icon-bg w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0">
                    <img src="https://api.iconify.design/mdi:weight-lifter.svg" alt="Rutina" class="w-8 h-8" style="filter: invert(1) brightness(2);">
                </div>
                <div>
                    <p class="text-text-muted text-sm">Rutina de Hoy</p>
                    <p class="text-white font-bold text-lg">Pecho y Tríceps</p>
                </div>
            </div>
            <!-- Card 2: Calorías -->
            <div class="summary-card rounded-xl p-6" style="animation: fadeInUp 0.7s ease-out;">
                <div class="flex justify-between items-center mb-2">
                    <p class="text-text-muted text-sm">Calorías</p>
                    <img src="https://api.iconify.design/mdi:fire.svg" alt="Calorías" class="w-6 h-6 text-primary-color">
                </div>
                <p class="text-white font-bold text-2xl">1,850 <span class="text-text-muted text-base">/ 2,500 kcal</span></p>
                <div class="progress-bar-container rounded-full h-2 mt-3 overflow-hidden">
                    <div class="progress-bar h-full rounded-full" style="width: 74%;"></div>
                </div>
            </div>
            <!-- Card 3: Hidratación -->
            <div class="summary-card rounded-xl p-6" style="animation: fadeInUp 0.8s ease-out;">
                <div class="flex justify-between items-center mb-2">
                    <p class="text-text-muted text-sm">Hidratación</p>
                    <img src="https://api.iconify.design/mdi:water-drop.svg" alt="Hidratación" class="w-6 h-6 text-primary-color">
                </div>
                <p class="text-white font-bold text-2xl">1.8 <span class="text-text-muted text-base">/ 2.5 L</span></p>
                <div class="progress-bar-container rounded-full h-2 mt-3 overflow-hidden">
                    <div class="progress-bar h-full rounded-full" style="width: 72%;"></div>
                </div>
            </div>
            <!-- Card 4: Horas de Sueño -->
            <div class="summary-card rounded-xl p-6 flex items-center space-x-4" style="animation: fadeInUp 0.9s ease-out;">
                <div class="icon-bg w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0">
                    <img src="https://api.iconify.design/mdi:moon-waning-crescent.svg" alt="Sueño" class="w-8 h-8" style="filter: invert(1) brightness(2);">
                </div>
                <div>
                    <p class="text-text-muted text-sm">Último Descanso</p>
                    <p class="text-white font-bold text-lg">7h 45min</p>
                </div>
            </div>
        </section>

        <!-- 3. Gráfico de Progreso y Acciones Rápidas -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Columna del Gráfico -->
            <div class="lg:col-span-2 chart-container rounded-xl p-6" style="animation: fadeInUp 1s ease-out;">
                <h3 class="text-xl font-bold text-white mb-4">Progreso Semanal (Peso en kg)</h3>
                <div class="h-64 flex items-end">
                    <!-- Placeholder de Gráfico con SVG animado -->
                    <svg class="w-full h-full" viewBox="0 0 500 200" preserveAspectRatio="none">
                        <polyline class="chart-line" points="0,150 100,120 200,140 300,90 400,60 500,40" />
                        <circle class="chart-dot" cx="100" cy="120" r="5" style="animation-delay: 0.4s;"></circle>
                        <circle class="chart-dot" cx="200" cy="140" r="5" style="animation-delay: 0.8s;"></circle>
                        <circle class="chart-dot" cx="300" cy="90" r="5" style="animation-delay: 1.2s;"></circle>
                        <circle class="chart-dot" cx="400" cy="60" r="5" style="animation-delay: 1.6s;"></circle>
                        <circle class="chart-dot" cx="500" cy="40" r="5" style="animation-delay: 2s;"></circle>
                    </svg>
                </div>
            </div>

            <!-- Columna de Acciones Rápidas -->
            <div class="summary-card rounded-xl p-6 flex flex-col justify-between" style="animation: fadeInUp 1.1s ease-out;">
                <div>
                    <h3 class="text-xl font-bold text-white mb-4">Acciones Rápidas</h3>
                    <div class="space-y-4">
                        <button class="w-full text-left flex items-center space-x-3 p-4 rounded-lg bg-dark-background/50 hover:bg-dark-background transition-colors duration-300">
                            <img src="https://api.iconify.design/mdi:plus-circle.svg" alt="Comida" class="w-6 h-6 text-secondary-color">
                            <span class="font-semibold text-white">Registrar Comida</span>
                        </button>
                        <button class="w-full text-left flex items-center space-x-3 p-4 rounded-lg bg-dark-background/50 hover:bg-dark-background transition-colors duration-300">
                            <img src="https://api.iconify.design/mdi:scale-bathroom.svg" alt="Peso" class="w-6 h-6 text-secondary-color">
                            <span class="font-semibold text-white">Actualizar Peso</span>
                        </button>
                    </div>
                </div>
                <a href="#" class="btn-custom-secondary font-bold py-3 px-6 rounded-full w-full text-center mt-6">
                    Ver todas mis rutinas
                </a>
            </div>
        </section>

    </div>

</body>
</html>

